<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jiaruiblog.infrastructure.repository.mysql.DocLogMapper">

    <resultMap id="DocLogResultMap" type="com.jiaruiblog.domain.entity.DocLog">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="action" column="action"/>
        <result property="docId" column="doc_id"/>
        <result property="docName" column="doc_name"/>
        <result property="createDate" column="create_date"/>
        <result property="updateDate" column="update_date"/>
    </resultMap>

    <insert id="save" parameterType="com.jiaruiblog.domain.entity.DocLog">
        INSERT INTO doc_log (id, user_id, user_name, action, doc_id, doc_name, create_date, update_date)
        VALUES (#{id}, #{userId}, #{userName}, #{action}, #{docId}, #{docName}, #{createDate}, #{updateDate})
    </insert>

    <select id="findById" resultMap="DocLogResultMap">
        SELECT * FROM doc_log WHERE id = #{id}
    </select>

    <select id="findByDocId" resultMap="DocLogResultMap">
        SELECT * FROM doc_log WHERE doc_id = #{docId} ORDER BY create_date DESC
    </select>

    <select id="findByUserId" resultMap="DocLogResultMap">
        SELECT * FROM doc_log WHERE user_id = #{userId} ORDER BY create_date DESC
    </select>

    <select id="findByAction" resultMap="DocLogResultMap">
        SELECT * FROM doc_log WHERE action = #{action} ORDER BY create_date DESC
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM doc_log
    </select>

    <delete id="deleteById">
        DELETE FROM doc_log WHERE id = #{id}
    </delete>

    <delete id="deleteAllByIdIn">
        DELETE FROM doc_log WHERE id IN
        <foreach collection="idList" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>